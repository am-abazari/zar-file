{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/app/components/*"],
      "@utils/*": ["./src/app/utils/*"],
      "@helper/*": ["./src/app/utils/helper/*"],
      "@functions/*": ["./src/app/utils/functions/*"],
      "@configs/*": ["./src/app/utils/configs/*"],
      "@assets/*": ["./src/app/assets/*"],
      "@icons/*": ["./src/app/assets/icons/*"],
      "@images/*": ["./src/app/assets/images/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}


